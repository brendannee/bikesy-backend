ARG BIKESY_RUNTIME_IMAGE=vcr.vercel.com/blinktag/bikesy-backend/dockerfile@sha256:7f8e2482a24ffdeca0fb7910f3bf44ea91b64ac9d60317e38c360654f5176505
FROM ${BIKESY_RUNTIME_IMAGE}

USER root
WORKDIR /app
COPY package.json serve.mjs release.json ./
COPY src ./src
COPY config ./config
COPY graph/deployed-runtime.lock.json ./graph/deployed-runtime.lock.json
COPY scripts/verify-release.mjs ./scripts/verify-release.mjs
RUN chmod -R a+rX /app && node scripts/verify-release.mjs --image
USER 65534:65534
ENV PORT=80 BIKESY_CONFIG=/app/config/sf.json MAX_CONCURRENT_ROUTES=2
EXPOSE 80
ENTRYPOINT ["node", "/app/serve.mjs"]
